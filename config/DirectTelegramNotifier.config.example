# DirectTelegramNotifier settings
# After editing, press F5 in the NinjaScript Editor or restart NinjaTrader.
# Anything after a # is a comment. A value the notifier cannot read is reported in Telegram at startup.
# Common settings first; advanced ones at the bottom, at their defaults. All settings: docs/configuration.md

# --- Telegram ---
BotToken=                           # from @BotFather; blank = use the NT_TELEGRAM_BOT_TOKEN environment variable
AuthorizedChatID=                   # your numeric Telegram user ID (ask @userinfobot); only you can send commands
FlattenConfirm=false                # true = /flatten and /lock ask you to confirm first

# --- Accounts ---
AccountName=Sim101                  # accounts to watch: one, a comma-separated list, or * for all
LeaderAccount=                      # copier users only: the account your copier copies from; blank = no copier

# --- End of day ---
EodReportTime=170000                # when your trading day ends (HHMMSS): daily report and new session
EodTimeZoneId=Eastern Standard Time # Windows time zone for EodReportTime

# --- Backup alerts (optional; treat both URLs like passwords) ---
HeartbeatUrl=                       # dead-man's switch ping, e.g. Healthchecks.io: tells you when alerts stop
BackupAlertUrl=                     # second channel for critical alerts, e.g. https://ntfy.sh/your-long-random-topic

# --- Drawdown floor ---
DrawdownMode=manual                 # off, manual, static, eod (end-of-day trailing) or intraday (intraday trailing)
RiskFloor=                          # manual: the floor in net liquidation dollars; blank = set it later with /floor
StartingBalance=                    # static, eod, intraday: account size
DrawdownAmount=                     # static, eod, intraday: maximum drawdown in dollars
FloorLock=                          # a trailing floor stops rising here; blank = never
RiskBufferAlerts=1500,750,300       # alert when net liquidation gets this close to the floor (dollars)
# Any risk setting can differ per account, e.g. DrawdownAmount:Acct002=2500

# --- Daily loss and prop-firm rules (blank = off) ---
DailyLossLimit=                     # dollars (1000) or % of the day's starting value (2%)
ConsistencyPercent=                 # best-day limit as % of total profit, e.g. 30; needs StartingBalance
InactivityDays=                     # days your firm allows without a trade

# --- Automatic flatten (off by default) ---
# On a breach the account is flattened and kept flat until /unlock or the session ends.
# Strategies and copiers are NOT stopped. Test on Sim first, then check that /selftest says ARMED.
RiskAutoFlatten=false               # when the drawdown floor is reached
DailyLossAutoFlatten=false          # when the daily loss limit is reached
ConsistencyAutoFlatten=false        # when today's profit reaches the consistency cap


# ======================================================================
# ADVANCED SETTINGS, at their defaults. Change one only if you need to.
# ======================================================================

# --- Alerts on or off ---
EnableWatchdog=true                 # connection, NinjaTrader freezing, start/stop and restart alerts
EnableExecutions=true               # fill alerts
EnableRemoteCommands=true           # accept commands from Telegram
EnableOrderRejectAlerts=true        # rejected-order alerts
EnableStrategyWatch=true            # strategy enabled / disabled / removed alerts
SilentRoutineAlerts=false           # true = routine messages arrive without a sound; problems still ring
FillGroupMs=2000                    # fills within this many ms become one message (500-10000)

# --- Orders and positions (0 = off) ---
RunawayMaxOrders=30                 # alert when this many new orders appear...
RunawayWindowSec=60                 # ...within this many seconds
ProtectiveCheckSeconds=0            # position with no working stop this long (only if your strategy places real stops)
OrphanOrderSeconds=20               # flat account with exit orders still working this long
OrphanOrderNames=Stop,Target        # order names that count as exit orders
StuckOrderSeconds=30                # order stuck in one of the states below this long
StuckOrderStates=Submitted,ChangePending,ChangeSubmitted,CancelPending,CancelSubmitted  # states that should pass quickly
MaxPositionContracts=0              # alert above this many contracts per account

# --- Trade copier (only with LeaderAccount) ---
FollowerRatio=1                     # follower size as a multiple of the leader's
MismatchSeconds=20                  # alert when a follower stays out of step this long (0 = off)

# --- Stale market data ---
StaleDataSeconds=120                # alert when a connected feed sends no ticks this long (0 = off)
StaleDataSchedule=cme               # when quiet is normal: cme, always or custom
StaleDataQuietWindows=              # custom only, e.g. Weekdays 16:00-24:00; Weekends 00:00-24:00
StaleDataTimeZone=Eastern Standard Time  # time zone for StaleDataQuietWindows
StaleDataInstruments=               # extra instruments to watch, also for rolls; traded and held ones are automatic

# --- Contract rolls ---
RollWarnDays=10                     # warn this many days before a futures contract in use expires (0 = off)

# --- Risk details ---
HighWaterBasis=balance              # eod trailing measured on balance (no open P&L) or netliq
RiskFlattenBuffer=150               # auto-flatten this many dollars above the floor
RiskConfirmSeconds=2                # a breach must last this long before auto-flatten acts (1-30)
FloorJumpConfirm=1000               # /floor asks you to confirm a change bigger than this
UnknownFlattenSeconds=0             # flatten if risk data is missing this long while in a trade (0 = alert only)
LockGroup=false                     # true = locking one account locks them all
DailyLossAlerts=50,75,90            # % of DailyLossLimit that alert
ConsistencyAlerts=75,90             # % of today's allowed profit that alert
ConsistencyProfitTarget=            # leave blank unless your firm measures against the profit target
InactivityAlerts=3,2,1              # days left that alert

# --- /flatten ---
FlattenHoldSeconds=30               # after /flatten, close anything that reopens this soon (0 = off)
UseGlobalFlattenEverything=false    # true = /flatten closes every connected account, not just these

# --- Backup channel and heartbeat ---
BackupAlertDetail=minimal           # minimal (no amounts) or full (only for a service you run yourself)
BackupAlertFormat=text              # text, or json for Slack and Discord webhooks
HeartbeatIntervalSec=60             # how often to ping HeartbeatUrl
RestartGapThresholdSec=45           # report downtime longer than this at startup

# --- NinjaTrader health (0 = off) ---
CpuAlertPercent=90                  # alert when NinjaTrader's CPU stays this high...
CpuAlertSeconds=180                 # ...for this many seconds
MemoryAlertMB=0                     # alert when NinjaTrader uses more memory than this
DiskAlertMB=2000                    # alert when free disk space falls below this

# --- Logs and reports ---
EnableAlertLog=true                 # copy every alert to DirectTelegramNotifier.log
EnableFillCsv=true                  # write every fill to DirectTelegramNotifier-fills.csv
EnableRiskLog=true                  # record risk readings for replay (up to 50 MB)
EstimatedCommissionPerSide=0        # commission per contract per side, used when NinjaTrader reports none

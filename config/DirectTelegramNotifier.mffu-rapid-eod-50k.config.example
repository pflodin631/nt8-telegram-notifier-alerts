# DirectTelegramNotifier settings: WORKED EXAMPLE, not a preset
# After editing, press F5 in the NinjaScript Editor or restart NinjaTrader. Anything after a # is a comment.
#
# The setup: three MyFundedFutures "Rapid EOD 50K" evaluation accounts on a Tradovate connection, one leader and two
# followers copied by Replikanto. Lines marked CHANGED differ from the defaults. Replace PLACEHOLDER values with your own.
# The numbers are what the firm's rules page showed in October 2026. Firms change their rules: check yours.
#
# Firm rules for this plan:  profit target 3,000 | max drawdown 2,000, end-of-day trailing | 3 contracts (micros 10:1)
#                            30% consistency rule | no daily loss limit | 7 days without a trade closes the account
# Set in Tradovate:          daily loss 600 | daily profit 850 (keeps every day under 30%) | weekly loss 1,200
#
# Notes
# 1. Tradovate enforces its own limits. This file only mirrors them as alerts, so the daily loss and consistency
#    auto-flatten switches stay off: two systems acting on one account can fight. Tradovate cannot see the firm's
#    trailing floor, though. Lose 1,200 one week and 800 the next and you reach it without the weekly limit tripping.
#    The floor is the one rule only this add-on watches: turn RiskAutoFlatten on once the Sim checks in docs/TESTING.md pass.
# 2. ConsistencyProfitTarget is a deliberate workaround. With it set, today's allowed profit is never below 30% of
#    3,000 = 900, so the 75% and 90% alerts fire near 675 and 810, just under Tradovate's 850. Without it the cap early
#    in an evaluation is tiny and the alerts are noise. It overstates your room if your firm does not measure against
#    the target; here Tradovate's 850 limit is the real stop.
# 3. There is no weekly loss setting and no daily profit setting. Those limits live in Tradovate only.

# --- Telegram ---
BotToken=                           # from @BotFather; blank = use the NT_TELEGRAM_BOT_TOKEN environment variable
AuthorizedChatID=                   # PLACEHOLDER: your numeric Telegram user ID
FlattenConfirm=false                # true = /flatten and /lock ask you to confirm first

# --- Accounts ---
AccountName=MFFUEVREOD000000001,MFFUEVREOD000000002,MFFUEVREOD000000003  # CHANGED, PLACEHOLDER: your three accounts
LeaderAccount=MFFUEVREOD000000001   # CHANGED, PLACEHOLDER: the account the copier copies from

# --- End of day ---
EodReportTime=170000                # the firm's trading day ends at 17:00 New York time
EodTimeZoneId=Eastern Standard Time # Windows time zone for EodReportTime

# --- Backup alerts (optional; treat both URLs like passwords) ---
HeartbeatUrl=                       # a secret, so blank here: a Healthchecks.io check that e-mails or texts you
BackupAlertUrl=                     # a secret, so blank here: an ntfy.sh topic with a long random name; then /testbackup

# --- Drawdown floor ---
DrawdownMode=eod                    # CHANGED: the firm trails the drawdown on the end-of-day balance
RiskFloor=                          # manual mode only
StartingBalance=50000               # CHANGED: account size; if an account already has profit, also use /risk seed
DrawdownAmount=2000                 # CHANGED: the plan's maximum drawdown
FloorLock=50100                     # CHANGED: the floor stops rising at starting balance + 100 (confirm this for your plan)
RiskBufferAlerts=1000,500,250       # CHANGED: tighter than the default because the whole drawdown is only 2,000

# --- Daily loss and prop-firm rules ---
DailyLossLimit=600                  # CHANGED: Tradovate's daily loss limit, for the 50/75/90% alerts; compare after day one
ConsistencyPercent=30               # CHANGED: the plan's 30% consistency rule
InactivityDays=7                    # CHANGED: the plan closes an account after 7 days without a trade

# --- Automatic flatten ---
RiskAutoFlatten=false               # turn on once the Sim checks pass (note 1)
DailyLossAutoFlatten=false          # off: Tradovate already enforces this limit (note 1)
ConsistencyAutoFlatten=false        # off: Tradovate's 850 profit limit already stops the day (note 1)

# --- Alerts on or off ---
EnableWatchdog=true                 # connection, NinjaTrader freezing, start/stop and restart alerts
EnableExecutions=true               # fill alerts
EnableRemoteCommands=true           # accept commands from Telegram
EnableOrderRejectAlerts=true        # rejected-order alerts
EnableStrategyWatch=true            # strategy enabled / disabled / removed alerts
SilentRoutineAlerts=true            # CHANGED: three accounts mean many fill messages; only problems should ring
FillGroupMs=2000                    # fills within this many ms become one message

# --- Orders and positions (0 = off) ---
RunawayMaxOrders=30                 # alert when this many new orders appear...
RunawayWindowSec=60                 # ...within this many seconds
ProtectiveCheckSeconds=0            # position with no working stop this long (only if your strategy places real stops)
OrphanOrderSeconds=20               # flat account with exit orders still working this long
OrphanOrderNames=Stop,Target        # order names that count as exit orders
StuckOrderSeconds=30                # order stuck in one of the states below this long
StuckOrderStates=Submitted,ChangePending,ChangeSubmitted,CancelPending,CancelSubmitted  # states that should pass quickly
MaxPositionContracts=30             # CHANGED: the plan allows 3 contracts, and micros count 10:1; this counts raw contracts

# --- Trade copier ---
FollowerRatio=1                     # followers trade the same size as the leader
MismatchSeconds=20                  # alert when a follower stays out of step this long

# --- Stale market data ---
StaleDataSeconds=120                # alert when a connected feed sends no ticks this long
StaleDataSchedule=cme               # CME futures hours: quiet overnight breaks and weekends are normal
StaleDataQuietWindows=              # custom schedules only
StaleDataTimeZone=Eastern Standard Time  # time zone for StaleDataQuietWindows
StaleDataInstruments=               # extra instruments to watch, also for rolls; traded and held ones are automatic

# --- Contract rolls ---
RollWarnDays=10                     # warn this many days before a futures contract in use expires

# --- Risk details ---
HighWaterBasis=balance              # closing balance without open P&L (the default); check your firm measures it this way
RiskFlattenBuffer=250               # CHANGED: wider than 150; a few seconds or one bad fill can move 3 contracts through 150
RiskConfirmSeconds=2                # a breach must last this long before auto-flatten acts
FloorJumpConfirm=500                # CHANGED: with a 2,000 drawdown, a 1,000 typo on /floor is too big to allow
UnknownFlattenSeconds=0             # alert only; a short data blip would otherwise cost the position
LockGroup=true                      # CHANGED: the accounts mirror each other, so a lock on one locks all of them
DailyLossAlerts=50,75,90            # % of DailyLossLimit that alert
ConsistencyAlerts=75,90             # % of today's allowed profit that alert
ConsistencyProfitTarget=3000        # CHANGED: deliberate workaround (note 2)
InactivityAlerts=3,2,1              # days left that alert; treat the last one as your deadline

# --- /flatten ---
FlattenHoldSeconds=30               # after /flatten, close anything that reopens this soon (catches the copier)
UseGlobalFlattenEverything=false    # /flatten closes only these accounts

# --- Backup channel and heartbeat ---
BackupAlertDetail=minimal           # no amounts go to the backup service
BackupAlertFormat=text              # right for ntfy.sh
HeartbeatIntervalSec=60             # how often to ping HeartbeatUrl
RestartGapThresholdSec=45           # report downtime longer than this at startup

# --- NinjaTrader health (0 = off) ---
CpuAlertPercent=90                  # alert when NinjaTrader's CPU stays this high...
CpuAlertSeconds=180                 # ...for this many seconds
MemoryAlertMB=0                     # alert when NinjaTrader uses more memory than this
DiskAlertMB=2000                    # alert when free disk space falls below this

# --- Logs and reports ---
EnableAlertLog=true                 # copy every alert to DirectTelegramNotifier.log
EnableFillCsv=true                  # write every fill to DirectTelegramNotifier-fills.csv
EnableRiskLog=true                  # record risk readings for replay (up to 50 MB)
EstimatedCommissionPerSide=0.95     # CHANGED: MFFU's commission per MNQ contract, used when NinjaTrader reports none
